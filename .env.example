COMPOSE_PROJECT_NAME=yazoo
APP_PORT=8000
FRONTEND_PORT=4173
LAN_HOST=localhost

# Exemple local sans secrets reels. Ne jamais publier .env.
# MySQL Docker publie le port local 3308 vers le port conteneur 3306.
# Le projet utilise MySQL Docker sur 3308; MongoDB reste reserve aux medias.
APP_KEY=

DB_DATABASE=yazoo
DB_USERNAME=yazoo
DB_PASSWORD=
DB_ROOT_PASSWORD=

REDIS_PASSWORD=

# Valeurs de developpement local uniquement. Utiliser des secrets explicites hors Compose local.
REVERB_APP_ID=yazoo-local
REVERB_APP_KEY=yazoo-local-key
REVERB_APP_SECRET=yazoo-local-secret-change-me

SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=
SONAR_DB_NAME=sonarqube
SONAR_DB_USERNAME=sonar
SONAR_DB_PASSWORD=

# Monitoring externe optionnel, a renseigner dans les secrets du fournisseur retenu.
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
APPINSIGHTS_CONNECTION_STRING=
