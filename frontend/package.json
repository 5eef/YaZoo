{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "author": "Youssef BOUGHIOUL",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "vite build --configLoader native && node scripts/generate-static-seo-pages.mjs && node scripts/check-legal-placeholders.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit:i18n": "node ../scripts/audit-i18n-completeness.mjs",
    "audit:legal": "node scripts/check-legal-placeholders.mjs",
    "audit:tailwind": "node scripts/check-tailwind-classes.mjs",
    "test": "vitest --configLoader native",
    "test:e2e": "node e2e/run-smoke.mjs",
    "screenshots:showcase": "node e2e/capture-showcase-screenshots.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "vitest run --coverage --configLoader native",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "laravel-echo": "^2.3.4",
    "prop-types": "^15.8.1",
    "pusher-js": "^8.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.4.21",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "^17.4.0",
    "jsdom": "^27.4.0",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
