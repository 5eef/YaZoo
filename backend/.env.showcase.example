APP_NAME=YaZoo
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<demo-host>
APP_FORCE_HTTPS=true
YAZOO_DEPLOYMENT_PROFILE=showcase
# L'application ne fait confiance qu'au Nginx local du conteneur.
TRUSTED_PROXIES=127.0.0.1

DB_CONNECTION=mysql
DB_HOST=<tidb-host>
DB_PORT=4000
DB_DATABASE=yazoo_showcase
DB_USERNAME=
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

YAZOO_RUN_MIGRATIONS=true
YAZOO_RUN_PRODUCTION_PREFLIGHT=true
YAZOO_REQUIRE_EXPECTED_DATABASE=true
YAZOO_EXPECTED_DB_HOST=<tidb-host>
YAZOO_EXPECTED_DB_PORT=4000
YAZOO_EXPECTED_DB_NAME=yazoo_showcase
YAZOO_PROTECTED_DB_NAMES=
YAZOO_RUNTIME_OPTIMIZE=true
YAZOO_RUN_SHOWCASE_BOOTSTRAP=true
YAZOO_SHOWCASE_BOOTSTRAP_ENABLED=true
YAZOO_SHOWCASE_CONFIRMATION=
YAZOO_SHOWCASE_APP_HOST=<demo-host>
YAZOO_SHOWCASE_DATABASE_HOST=<tidb-host>
YAZOO_SHOWCASE_DATABASE_NAME=yazoo_showcase
YAZOO_SHOWCASE_PASSWORD=
YAZOO_SHOWCASE_MFA_SECRET=
YAZOO_SHOWCASE_MFA_RECOVERY_CODES=
YAZOO_SHOWCASE_IMAGES_PATH=/opt/yazoo-showcase-images
YAZOO_SHOWCASE_UPLOADS_ENABLED=false

YAZOO_REQUIRE_PERSISTENT_STORAGE=false
YAZOO_PERSISTENT_STORAGE_PATH=
FILESYSTEM_DISK=public
PUBLIC_STORAGE_URL=/storage
PRIVATE_STORAGE_PATH=/var/www/html/storage/app/private
MEDIA_STORAGE_DRIVER=filesystem
MEDIA_FILESYSTEM_DISK=public
MEDIA_SCAN_ENABLED=false
MEDIA_SCAN_REQUIRED_IN_PRODUCTION=false
MEDIA_MONGODB_ENABLED=false
MEDIA_BACKUP_ENABLED=false

SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=<demo-host>
CORS_ALLOWED_ORIGINS=https://<demo-host>

# Le showcase utilise sync pour eviter un worker et un scheduler 24/7 sur le free tier.
QUEUE_CONNECTION=sync
CACHE_STORE=database
YAZOO_FULLTEXT_SEARCH_ENABLED=false
YAZOO_ACCOUNT_DELETION_UNIQUE_LOCK_STORE=database
YAZOO_RUN_QUEUE_WORKER=false
YAZOO_RUN_SCHEDULER=false
YAZOO_REQUIRE_SCHEDULER_HEARTBEAT=false
YAZOO_REQUIRE_REVERB_HEALTH=false
BROADCAST_CONNECTION=log

ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_MFA_ENFORCED=true
SMS_DRIVER=disabled
CMI_ENABLED=false

# Sans Brevo, log est volontairement accepte uniquement par le profil showcase.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=noreply@<demo-host>
MAIL_FROM_NAME="YaZoo"
CONTACT_RECIPIENT=bough.youssef@gmail.com

LEGAL_ENTITY_NAME=YaZoo Showcase
LEGAL_STATUS=Projet de demonstration
LEGAL_ADDRESS=Maroc
LEGAL_ICE=DEMO-NON-VALABLE
PRIVACY_CONTACT_EMAIL=bough.youssef@gmail.com
DATA_CONTROLLER_NAME=Youssef BOUGHIOUL
DATA_RETENTION_DAYS=30
DATA_REQUEST_RESPONSE_DAYS=30

FRONTEND_URL=https://<demo-host>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://<demo-host>/api/auth/google/callback
GOOGLE_FRONTEND_REDIRECT=https://<demo-host>/feed
GOOGLE_LOGIN_REDIRECT=https://<demo-host>/login

# Configuration R2 future, facultative.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
