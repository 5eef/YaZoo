{
  "expo": {
    "name": "YaZoo",
    "slug": "yazoo-pilot",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FAF7FF",
        "foregroundImage": "./assets/brand/adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.yazoo.pilot"
    },
    "web": {
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "./plugins/with-release-signing",
      "expo-video",
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF7FF",
          "image": "./assets/brand/yazoo-symbol.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#10091A"
          }
        }
      ]
    ],
    "scheme": "yazoo-pilot",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "55196a69-8fc1-4849-be9f-c01964b0f9dd"
      }
    },
    "owner": "youssef5ef"
  }
}
