FROM php:8.4-fpm-alpine@sha256:5992f8b7433fe7fa96dfbf67746c86d6c41bc91e686eac38fe531c72a02e40e4 AS php-vendor

WORKDIR /app
COPY --from=composer:2@sha256:4d71c3c2109c61d5415544264b59ad4087e4c5b7244481723664138fd36d5040 /usr/bin/composer /usr/bin/composer
RUN set -eux; \
    apk add --no-cache --virtual .build-deps $PHPIZE_DEPS linux-headers; \
    pecl install mongodb-2.3.3; \
    docker-php-ext-enable mongodb; \
    apk del .build-deps
COPY backend/composer.json backend/composer.lock ./
RUN composer install --no-dev --prefer-dist --no-interaction --no-progress --no-scripts

FROM php:8.4-fpm-alpine@sha256:5992f8b7433fe7fa96dfbf67746c86d6c41bc91e686eac38fe531c72a02e40e4 AS runtime

ARG APP_VERSION=local
ENV APP_VERSION=$APP_VERSION

LABEL org.opencontainers.image.title="YaZoo API Demo" \
      org.opencontainers.image.description="Backend-only Laravel recruiter showcase." \
      org.opencontainers.image.authors="Youssef BOUGHIOUL <bough.youssef@gmail.com>" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.vendor="Youssef BOUGHIOUL"

WORKDIR /var/www/html
COPY --from=composer:2@sha256:4d71c3c2109c61d5415544264b59ad4087e4c5b7244481723664138fd36d5040 /usr/bin/composer /usr/bin/composer
RUN set -eux; \
    apk add --no-cache bash ca-certificates icu-libs libzip nginx su-exec; \
    apk upgrade --no-cache libcrypto3 libssl3 openssl; \
    apk add --no-cache --virtual .build-deps $PHPIZE_DEPS icu-dev libzip-dev linux-headers; \
    docker-php-ext-install bcmath intl opcache pcntl pdo_mysql zip; \
    pecl install redis-6.3.0 mongodb-2.3.3; \
    docker-php-ext-enable redis mongodb opcache; \
    apk del .build-deps; \
    sed -i '/^user[[:space:]]/d' /etc/nginx/nginx.conf

COPY --from=php-vendor /app/vendor ./vendor
COPY backend/ ./
COPY backend/database/seeders/assets/marketplace/ /opt/yazoo-showcase-images/
COPY LICENSE /licenses/YaZoo-LICENSE
COPY backend/php-upload.ini /usr/local/etc/php/conf.d/yazoo-upload.ini
COPY backend/nginx.conf /etc/nginx/http.d/default.conf

RUN set -eux; \
    composer dump-autoload --optimize; \
    php artisan package:discover --ansi; \
    test "$(find /opt/yazoo-showcase-images -maxdepth 1 -type f -name '*.png' | wc -l)" -eq 21; \
    mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache; \
    chown -R www-data:www-data storage bootstrap/cache /opt/yazoo-showcase-images /var/www/html

COPY backend/startup.sh /usr/local/bin/yazoo-startup
COPY backend/docker-entrypoint.sh /usr/local/bin/yazoo-entrypoint
RUN chmod +x /usr/local/bin/yazoo-startup /usr/local/bin/yazoo-entrypoint

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8080/health/live >/dev/null || exit 1

ENTRYPOINT ["yazoo-entrypoint"]
CMD ["yazoo-startup"]
